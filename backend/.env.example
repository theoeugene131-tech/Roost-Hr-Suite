PORT=4001
JWT_SECRET=change-this-to-a-long-random-string

# 32-byte hex key for encrypting bank accounts, NIN, PAYE TIN, pension PIN.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

DATABASE_URL=postgres://postgres:devpassword@localhost:5432/roost

# Used in invite-employee links, e.g. https://roost-hr-suite.vercel.app
APP_URL=http://localhost:3000
