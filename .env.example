# Never commit real secrets. Set these in Vercel Environment Variables for production.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep LICENSE_SECRET unchanged after issuing keys; changing it invalidates existing keys.
LICENSE_SECRET=
# Optional comma-separated list of revoked keys.
REVOKED_LICENSES=
# Set to 1 only on a separate demo deployment to permit ?demo=1.
NEXT_PUBLIC_ALLOW_DEMO=
